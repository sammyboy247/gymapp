+const bookSession = async (sessionId: string, userId: string, programId: string): Promise<string> => {
+  try {
+    const bookingId = await runTransaction(db, async (transaction) => {
+      const sessionRef = doc(db, 'schedules', sessionId);
+      const sessionDoc = await transaction.get(sessionRef);
+
+      if (!sessionDoc.exists()) {
+        throw new Error('Session not found.');
+      }
+
+      const sessionData = sessionDoc.data() as Schedule;
+
+      if (sessionData.spotsRemaining <= 0) {
+        throw new Error('This session is already full.');
+      }
+
+      const bookingsQuery = query(
+        collection(db, 'bookings'),
+        where('sessionId', '==', sessionId),
+        where('userId', '==', userId),
+        where('status', '==', 'active'),
+        limit(1)
+      );
+      
+      const userBookingSnapshot = await getDoc(doc(db, 'bookings'));
+      if (!userBookingSnapshot.exists()) {
+        throw new Error('You are already booked for this session.');
+      }
+      
+      transaction.update(sessionRef, {
+        spotsRemaining: sessionData.spotsRemaining - 1,
+      });
+
+      const bookingData: Omit<Booking, 'id'> = {
+        userId,
+        sessionId,
+        programId,
+        bookedAt: Timestamp.now(),
+        status: 'active',
+      };
+      
+      const bookingRef = doc(collection(db, 'bookings'));
+      transaction.set(bookingRef, bookingData);
+
+      return bookingRef.id;
+    });
+
+    return bookingId;
+  } catch (error) {
+    console.error('Booking failed:', error);
+    throw error;
+  }
+};
+
+const cancelBooking = async (bookingId: string, sessionId: string, userId: string): Promise<void> => {
+  try {
+    await runTransaction(db, async (transaction) => {
+      const bookingRef = doc(db, 'bookings', bookingId);
+      const sessionRef = doc(db, 'schedules', sessionId);
+
+      const bookingDoc = await transaction.get(bookingRef);
+      const sessionDoc = await transaction.get(sessionRef);
+
+      if (!bookingDoc.exists() || bookingDoc.data().userId !== userId) {
+        throw new Error('Booking not found or you do not have permission to cancel it.');
+      }
+      
+      if (!sessionDoc.exists()) {
+        // Even if session is deleted, allow cancellation
+        transaction.update(bookingRef, { status: 'cancelled' });
+        return;
+      }
+      
+      const sessionData = sessionDoc.data() as Schedule;
+
+      transaction.update(bookingRef, { status: 'cancelled' });
+      transaction.update(sessionRef, {
+        spotsRemaining: sessionData.spotsRemaining + 1,
+      });
+    });
+  } catch (error) {
+    console.error('Cancellation failed:', error);
+    throw error;
+  }
+};
+
+const getUserBookings = (userId: string, callback: (bookings: Booking[]) => void) => {
+  const bookingsQuery = query(
+    collection(db, 'bookings'),
+    where('userId', '==', userId),
+    where('status', '==', 'active')
+  );
+
+  const unsubscribe = onSnapshot(bookingsQuery, querySnapshot => {
+    const bookings = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() } as Booking));
+    callback(bookings);
+  });
+
+  return unsubscribe;
+};
+
