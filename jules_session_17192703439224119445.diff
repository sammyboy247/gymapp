+// Establish a listener for real-time schedule updates
+const getSchedules = (
+  startDate: Date,
+  endDate: Date,
+  sessionTypeFilter: string | null,
+  callback: (schedules: Schedule[]) => void
+) => {
+  let schedulesQuery = query(
+    collection(db, 'schedules'),
+    where('startTime', '>=', Timestamp.fromDate(startDate)),
+    where('startTime', '<=', Timestamp.fromDate(endDate)),
+    orderBy('startTime')
+  );
+
+  if (sessionTypeFilter) {
+    schedulesQuery = query(
+      collection(db, 'schedules'),
+      where('startTime', '>=', Timestamp.fromDate(startDate)),
+      where('startTime', '<=', Timestamp.fromDate(endDate)),
+      where('sessionType', '==', sessionTypeFilter),
+      orderBy('startTime')
+    );
+  }
+
+  const unsubscribe = onSnapshot(schedulesQuery, querySnapshot => {
+    const schedules = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() } as Schedule));
+    callback(schedules);
+  });
+
+  return unsubscribe;
 };
 
